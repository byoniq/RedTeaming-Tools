# WordPress MCP connector credentials.
# Copy this file to `.env` (which is gitignored) and fill in real values.
# These env vars are referenced from .mcp.json via ${VAR_NAME} expansion.

# --- aladdinelston.com ---
ALADDIN_WP_USERNAME=
ALADDIN_WP_APP_PASSWORD=

# --- sentinelsec.ai ---
SENTINELSEC_WP_USERNAME=
